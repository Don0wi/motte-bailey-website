# Required for production: use a random secret of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
NODE_ENV=development
DATA_DIR=./data

# Staff bootstrap: set these before the first start to create the first admin.
# Use a unique password of at least 12 characters. Remove ADMIN_PASSWORD after bootstrap.
ADMIN_EMAIL=manager@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-12-chars-minimum

# Reservations remain disabled until the restaurant confirms its real booking rules.
BOOKING_ENABLED=false
BOOKING_RULES_CONFIRMED=false

# Optional SMTP configuration for restaurant notifications.
RESTAURANT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
